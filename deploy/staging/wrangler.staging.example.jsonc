// STAGING-VORLAGE. Nicht mit `wrangler deploy` ohne Anpassung verwenden.
// Grund: wrangler.jsonc hat den Worker-Namen "flyer-map" (= Produktion). Ein Deploy aus dem Repo
// würde den Produktions-Worker überschreiben. Diese Datei nutzt einen eigenen Namen und eigene Bindings.
// Vor dem Gebrauch: alle "FILL_ME" ersetzen; neue Ressourcen (D1, Durable Objects, Rate-Limits) anlegen,
// NICHT die Produktions-IDs aus wrangler.jsonc übernehmen.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flyer-map-staging",
  "main": "../../worker/indexOrganizer.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "binding": "ASSETS",
    "directory": "../../dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "flyer-map-staging-db", "database_id": "FILL_ME_STAGING_D1_ID" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CAMPAIGN_SYNC", "class_name": "CampaignSyncDurableObject" },
      { "name": "ORGANIZATION_PASSWORD_KDF", "class_name": "OrganizationPasswordKdfDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1-campaign-sync", "new_sqlite_classes": ["CampaignSyncDurableObject"] },
    { "tag": "v2-organization-password-kdf", "new_sqlite_classes": ["OrganizationPasswordKdfDurableObject"] }
  ],
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "RUNTIME_ENVIRONMENT": "staging",
    "ORGANIZATION_KDF_DIAGNOSTICS": "0",
    "OSM_OVERPASS_URL": "default"
  }
}
