{
  "name": "flyer-map",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "verify": "npm test && npm run typecheck && npm run audit:dependencies",
    "check": "npm run verify && npm run build",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "@turf/length": "7.3.1",
    "@turf/line-slice-along": "7.3.1",
    "@turf/nearest-point-on-line": "7.3.1",
    "jsts": "2.12.1",
    "maplibre-gl": "6.9.0",
    "qrcode.react": "4.2.0",
    "rbush": "4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rxdb": "17.5.0",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.0",
    "@types/rbush": "4.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-test-renderer": "19.1.0",
    "@vitejs/plugin-react": "6.1.0",
    "fake-indexeddb": "6.2.5",
    "react-test-renderer": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wrangler": "4.125.0"
  },
  "overrides": {
