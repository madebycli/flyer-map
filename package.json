{
  "name": "flyer-map",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "audit:dependencies": "npm audit --audit-level=high",
    "check": "npm test && npm run typecheck && npm run build && npm run audit:dependencies",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "maplibre-gl": "5.7.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.48.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wrangler": "4.125.0"
  },
  "engines": {
    "node": ">=22"
  }
}
